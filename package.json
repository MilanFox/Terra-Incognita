{
  "name": "terra-incognita-ii",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nuxt build",
    "generate": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node scripts/data/fetch.ts",
    "data:build": "node scripts/data/build.ts",
    "prepare": "husky || true",
    "generate:pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@nuxtjs/i18n": "~10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@vite-pwa/nuxt": "1.1.1",
    "maplibre-gl": "^6.19.0",
    "nuxt": "4.6.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.27",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.13.0",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "mapshaper": "0.8.4",
    "postcss-pxtorem": "^6.1.0",
    "sass": "^1.97.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.2.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.13.0": true
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix"
  }
}
